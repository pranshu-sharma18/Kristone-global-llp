# Gmail SMTP settings for Buyer Inquiry Form
# Copy this file to .env.local and fill in your values.
# Location of secrets: project root -> .env.local

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your registered website email (sender login)
SMTP_USER=kristoneglobalmarble@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# Create one at: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=your_16_character_app_password_here

# Where inquiries should be delivered
INQUIRY_TO_EMAIL=kristoneglobalmarble@gmail.com

# --- Google Sign-In (Auth.js / NextAuth) ---
# 1) Open Google Cloud Console -> APIs & Services -> Credentials
# 2) Create OAuth 2.0 Client ID (Web application)
# 3) Authorized JavaScript origins: http://localhost:3000
# 4) Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 5) For live site, also add https://your-domain.com and
#    https://your-domain.com/api/auth/callback/google

AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# Random secret for session encryption (generate your own):
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# Or: openssl rand -base64 32
AUTH_SECRET=replace_with_a_long_random_secret

# Site URL (local or production)
AUTH_URL=http://localhost:3000

# Visitor emails are stored at:
#   data/google-visitors.json
# New logins also email INQUIRY_TO_EMAIL when SMTP is configured.
